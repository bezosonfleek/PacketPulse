# ── Postgres ──────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=packetpulse
DB_USER=pp_user
DB_PASSWORD=change_me_before_deploy

# ── JWT ───────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRY_HOURS=8

# ── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Security ──────────────────────────────────────────────
# Max failed logins before account lockout
LOGIN_MAX_ATTEMPTS=5
# Rate limit: max signin attempts per IP per minute
RATE_LIMIT_SIGNIN=8