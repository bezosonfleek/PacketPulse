#  PacketPulse — Environment Variables
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit .env to git. It contains secrets.
#  .env.example (with blank values) is safe to commit.
# ──────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────
# These must match POSTGRES_DB / USER / PASSWORD in docker-compose.yml
# DB_HOST must be "db" — that is the Docker service name,
# which Docker's internal DNS resolves to the db container's IP.
DB_HOST=db
DB_PORT=5432
DB_NAME=packetpulse
DB_USER=pp_user
DB_PASSWORD=change_me_strong_password

# ── Auth ───────────────────────────────────────────────────────
# JWT_SECRET signs all auth tokens. Use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=change_me_generate_a_real_secret
JWT_EXPIRY_HOURS=24

# ── Server ─────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── CORS ───────────────────────────────────────────────────────
# In Docker, the browser talks to Nginx on localhost:3000.
# Nginx proxies to backend internally, so ALLOWED_ORIGIN
# should be the URL the browser uses (your Nginx address).
# For local Docker: http://localhost:3000
# For production:   https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:3000

# ── App URLs ───────────────────────────────────────────────────
# Used in email links (verification, password reset).
# For local Docker: http://localhost:3000
# For production:   https://yourdomain.com
APP_BASE_URL=http://localhost:3000

# ── SMTP (email) ───────────────────────────────────────────────
# Leave SMTP_HOST empty to use dev mode (emails printed to console).
# For Gmail: host=smtp.gmail.com, port=587, use an App Password.
# Generate App Password at: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=port
SMTP_USER=user@email.com
SMTP_PASSWORD=gene rated pass word
SMTP_FROM=user@email.com
